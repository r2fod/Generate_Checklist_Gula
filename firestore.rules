rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un evento concreto: se puede abrir y editar SOLO si conoces su ID (el link).
    // No se permite "listar" todos los eventos de golpe.
    match /eventos/{id} {
      allow get, write: if true;
      allow list: if false;
    }

    // El archivo de eventos guardados: solo el equipo con sesión iniciada.
    // Aquí viven tanto el documento antiguo con todos los eventos juntos
    // ("eventosGuardados", que se conserva como copia de seguridad) como un documento
    // por evento con prefijo "evt_", que es lo que se usa desde que el archivo dejó
    // de caber en un único documento (Firestore no admite más de 1 MiB por documento).
    match /indice/{doc} {
      allow read, write: if request.auth != null;
    }

    // ─── FORMULARIO DE OFICINA ───────────────────────────────────────────────
    // La lista corta de los próximos eventos que ve quien rellena el formulario:
    // SOLO nombre, día y sitio de los 8 siguientes, para que pueda elegir a cuál
    // van los datos en vez de crear un duplicado. Ni pax, ni cantidades, ni
    // logística, ni la checklist.
    //
    // Se lee igual que un evento por su link: hay que conocer el código, que es el
    // nombre del documento. Sin el código no se puede ni listar ni adivinar. La
    // escribe la app, que sí tiene sesión iniciada, cada vez que cambian los eventos;
    // y regenerar el código deja el anterior sin nada que leer.
    match /publico/{codigo} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null;
    }

    // Lo que manda la oficina. Cualquiera con el código puede CREAR un envío, y
    // nada más: no puede leer los de otros, ni cambiarlos, ni borrarlos. Eso solo
    // el equipo con sesión iniciada, que es quien los revisa en la bandeja.
    //
    // Se valida la forma para que el buzón no se pueda usar para otra cosa: los
    // campos justos, tamaño acotado y fecha de envío la del servidor.
    match /envios/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                        ["codigo", "respuestas", "enviado", "eventoDestino", "version"])
                    && request.resource.data.respuestas is map
                    && request.resource.data.enviado == request.time
                    && request.resource.data.size() <= 5;

      // Corregir lo ya mandado (cambian los pax, se cae la barra libre...) MIENTRAS
      // logística no lo haya revisado. Hay que conocer el id del documento, que solo
      // tiene quien lo mandó, guardado en su móvil. No se puede cambiar el código, ni
      // tocar uno ya revisado, ni colar campos nuevos: una corrección es una
      // corrección y no una puerta para otra cosa.
      // Ojo: se pregunta si el campo EXISTE, no si vale null. Leer un campo que no
      // está hace fallar la regla entera, y un envío recién mandado no tiene
      // "revisado": con la comparación a null no se habría podido corregir ninguno.
      allow update: if request.auth == null
                    && !("revisado" in resource.data)
                    && request.resource.data.codigo == resource.data.codigo
                    && request.resource.data.keys().hasOnly(
                         ["codigo", "respuestas", "enviado", "eventoDestino", "version", "corregido"])
                    && request.resource.data.respuestas is map
                    && request.resource.data.enviado == request.time
                    && request.resource.data.size() <= 6;

      allow get, list, update, delete: if request.auth != null;
    }

    // Todo lo demás: denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
