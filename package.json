{
  "name": "generate-checklist-gula-1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "worker:build": "rolldown worker/index.js -o worker/pegar.js -f esm --platform neutral",
    "predeploy": "npm run test",
    "deploy": "gh-pages -d dist",
    "test": "node src/__tests__/calculos.test.mjs && node src/__tests__/asistente.test.mjs && npm run build && node src/__tests__/sincronizacion.test.mjs && node src/__tests__/app.test.mjs",
    "test:rapido": "npm run tipos && node src/__tests__/calculos.test.mjs && node src/__tests__/asistente.test.mjs && npm run build && node src/__tests__/sincronizacion.test.mjs",
    "tipos": "tsc -p jsconfig.json",
    "medir": "node pruebas/medir.mjs",
    "reglas:deploy": "firebase deploy --only firestore:rules",
    "reglas:test": "node pruebas/reglas.test.mjs",
    "reglas:emulador": "firebase emulators:exec --only firestore \"node pruebas/reglas.test.mjs\"",
    "test:calc": "node src/__tests__/calculos.test.mjs",
    "test:sync": "node src/__tests__/sincronizacion.test.mjs",
    "test:app": "node src/__tests__/app.test.mjs"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.71.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.1"
  }
}
